{
    "extends":  "../../tsconfig.base.json",
    "compilerOptions":  {
                            "rootDir":  "src",
                            "outDir":  "dist",
                            "jsx":  "react-jsx",
                            "types":  [
                                          "vite/client",
                                          "react",
                                          "react-dom"
                                      ]
                        },
    "include":  [
                    "src/**/*.ts",
                    "src/**/*.tsx",
                    "src/**/*.d.ts"
                ],
    "exclude":  [
                    "src/**/*.spec.ts",
                    "src/**/*.spec.tsx"
                ]
}
