                    "test:integration":  "npm run build \u0026\u0026 node dist/run-integration-tests.js"
                },
    "dependencies":  {
                         "socket.io":  "^4.8.1"
                     },
    "devDependencies":  {
                            "@types/node":  "^24.6.0",
                            "socket.io-client":  "^4.8.1"
                        }
}
