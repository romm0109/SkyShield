{
  "name": "@skyshield/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "npm run build && node dist/run-tests.js",
    "test:integration": "npm run build && node dist/run-integration-tests.js"
  },
  "dependencies": {
    "@skyshield/shared-types": "0.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "socket.io-client": "^4.8.1"
  }
}
